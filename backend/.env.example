# BalanceVault Backend – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Used by Prisma Client at runtime (app_user role — DML only)
DATABASE_URL=postgresql://app_user:your_password@localhost:5432/balancevault

# Used only during Prisma migrations (app_migrate role — DDL access)
# If using Neon, this can be the same URL with a different role
DATABASE_MIGRATE_URL=postgresql://app_migrate:your_password@localhost:5432/balancevault

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
JWT_SECRET=replace_with_a_very_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=24h

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optional in development (rate limiting falls back to in-memory)
# Required in production
# Example for Upstash: redis://default:password@your-host.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
# ── Idempotency ───────────────────────────────────────────────────────────────
IDEMPOTENCY_TTL_HOURS=24

# ── First Admin (seed script only — do not use in app) ───────────────────────
# Set these only when running: node prisma/seed.js
# Remove from env after seeding.
ADMIN_EMAIL=admin@balancevault.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Admin

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
